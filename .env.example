#  App 
APP_NAME=Parsero
APP_VERSION=0.1.0
APP_ENV=development
APP_DEBUG=true

#  Base de datos 
# Local con docker-compose:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/extractor_db
# Railway: usar el DATABASE_URL del Postgres service y reemplazar el prefijo
# 'postgresql://' por 'postgresql+asyncpg://'

#  Redis 
REDIS_URL=redis://localhost:6379/0

#  LLM provider 
LLM_PROVIDER=gemini
LLM_MAX_TOKENS=2048

# Gemini (free tier - recomendado): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Anthropic (premium opcional): https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

#  Seguridad 
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambiar-por-string-aleatorio-de-64-chars
JWT_ALGORITHM=HS256
JWT_SESSION_TTL_HOURS=168
JWT_EMAIL_VERIFY_TTL_HOURS=24
JWT_PASSWORD_RESET_TTL_HOURS=1

#  Rate limiting 
RATE_LIMIT_PER_MINUTE=100

#  Resend (email transaccional) 
# Crear cuenta + API key: https://resend.com
RESEND_API_KEY=
EMAIL_FROM=Parsero <onboarding@resend.dev>
PUBLIC_BASE_URL=http://localhost:8000

#  Lemon Squeezy (billing, Fase 5.2) 
# Crear store + API key + webhook: https://app.lemonsqueezy.com
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_STARTER=
LEMONSQUEEZY_VARIANT_PRO=
